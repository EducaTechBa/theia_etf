    private async handleProgramCrash() {
        try {
            this.isProcessing = true;
            this.errorMessage = '';
            this.aiResponse = '';
            this.update();

            // Step 1: Get current editor
            const editorWidget = this.editorManager.currentEditor;
            if (!editorWidget) {
                this.errorMessage = this.t('noFileOpen');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 2: Get file path and read contents
            const fileUri = editorWidget.getResourceUri();
            if (!fileUri) {
                this.errorMessage = this.t('noFilePath');
                this.isProcessing = false;
                this.update();
                return;
            }

            const relativePath = this.getRelativePath(fileUri);
            const fileContent = await this.fileService.read(fileUri);
            const code = fileContent.value;

            // Step 3: Try to read .asan.out file from same directory
            const fileDir = fileUri.parent;
            const asanOutUri = new URI(fileDir.toString() + '/.asan.out');

            let asanOutput: string = '';
            let asanFileFound = false;
            try {
                const asanOutContent = await this.fileService.read(asanOutUri);
                asanOutput = asanOutContent.value.trim();
                asanFileFound = true;
                console.log('AI Assistant: Found .asan.out file');
            } catch (error) {
                console.log('AI Assistant: No .asan.out file found');
            }

            // Step 4: Check if .asan.out is missing or empty - show warning
            if (!asanFileFound || asanOutput === '') {
                console.log('AI Assistant: .asan.out missing or empty, showing warning');
                this.showCrashWarning = true;
                this.crashCode = code;
                this.crashPath = relativePath;
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 5: Check if .asan.out is older than source file
            const fileStats = await this.fileService.resolve(fileUri);
            const asanStats = await this.fileService.resolve(asanOutUri);
            if (asanStats.mtime && fileStats.mtime && asanStats.mtime < fileStats.mtime) {
                // Source file was modified after asan.out
                this.warningContext = { relativePath, code, asanOutput, fileUri, asanOutUri };
                this.showStaleAsanWarning = true;
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 6: .asan.out exists, has content, and is fresh - proceed with analysis
            await this.submitCrashRequest('crash', relativePath, code, asanOutput);

        } catch (error) {
            console.error('AI Assistant: Error handling program crash', error);
            this.errorMessage = `Unexpected error: ${error}`;
        } finally {
            this.isProcessing = false;
            this.update();
        }
    }

    private async handleTestsFailing() {
        try {
            this.isProcessing = true;
            this.errorMessage = '';
            this.aiResponse = '';
            this.update();

            // Step 1: Get current editor
            const editorWidget = this.editorManager.currentEditor;
            if (!editorWidget) {
                this.errorMessage = this.t('noFileOpen');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 2: Get file path and read contents
            const fileUri = editorWidget.getResourceUri();
            if (!fileUri) {
                this.errorMessage = this.t('noFilePath');
                this.isProcessing = false;
                this.update();
                return;
            }

            const relativePath = this.getRelativePath(fileUri);
            const fileContent = await this.fileService.read(fileUri);
            const code = fileContent.value;

            // Step 3: Read .autotest3 file
            const fileDir = fileUri.parent;
            const autotestUri = new URI(fileDir.toString() + '/.autotest3');

            let autotestContent: string;
            try {
                const autotestFile = await this.fileService.read(autotestUri);
                autotestContent = autotestFile.value;
            } catch (error) {
                this.errorMessage = this.t('testsNotFound');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 4: Read .at_result file
            const atResultUri = new URI(fileDir.toString() + '/.at_result');

            let atResultContent: string;
            try {
                const atResultFile = await this.fileService.read(atResultUri);
                atResultContent = atResultFile.value;
            } catch (error) {
                this.errorMessage = this.t('testResultsNotFound');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 5: Call API
            const formData = new FormData();
            formData.append('action', 'autotest');
            formData.append('path', relativePath);
            formData.append('code', code);
            formData.append('autotest', autotestContent);
            formData.append('result', atResultContent);

            const response = await fetch('/api/v1/ai/asistent', {
                method: 'POST',
                credentials: 'include',
                body: formData
            });

            if (!response.ok) {
                await this.handleApiError(response);
                this.isProcessing = false;
                this.update();
                return;
            }

            const data = await response.json();

            // Handle special cases
            if (data.message === 'main function not found') {
                this.errorMessage = this.t('mainNotFound');
                this.isProcessing = false;
                this.update();
                return;
            }

            if (data.message === 'No failed test was found') {
                this.errorMessage = this.t('noFailedTests');
                this.isProcessing = false;
                this.update();
                return;
            }

            if (data.data) {
                this.aiResponse = data.data;
            } else {
                this.errorMessage = this.t('apiError');
            }

        } catch (error) {
            console.error('AI Assistant: Error handling tests failing', error);
            this.errorMessage = `Unexpected error: ${error}`;
        } finally {
            this.isProcessing = false;
            this.update();
        }
    }

    private async handleCompileError() {
        try {
            this.isProcessing = true;
            this.errorMessage = '';
            this.aiResponse = '';
            this.update();

            // Step 1: Get current editor
            const editorWidget = this.editorManager.currentEditor;
            if (!editorWidget) {
                this.errorMessage = this.t('noFileOpen');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Step 2: Get file path
            const fileUri = editorWidget.getResourceUri();
            if (!fileUri) {
                this.errorMessage = this.t('noFilePath');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Get workspace root
            const workspaceRoot = this.workspaceService.workspace?.resource;
            if (!workspaceRoot) {
                this.errorMessage = 'No workspace is open.';
                this.isProcessing = false;
                this.update();
                return;
            }

            // Calculate relative path
            const relativePath = this.getRelativePath(fileUri);

            // Step 3: Read file contents
            const fileContent = await this.fileService.read(fileUri);
            const code = fileContent.value;

            // Step 4: Read .gcc.out file
            const fileDir = fileUri.parent;
            const gccOutUri = new URI(fileDir.toString() + '/.gcc.out');

            let gccOutput: string;
            let gccFileExists = false;
            try {
                const gccOutContent = await this.fileService.read(gccOutUri);
                gccOutput = gccOutContent.value;
                gccFileExists = true;
            } catch (error) {
                gccOutput = '';
            }

            // Validation 1: Check if gcc output is empty or file doesn't exist
            if (!gccFileExists || gccOutput.trim() === '') {
                this.errorMessage = this.t('emptyGccMessage');
                this.isProcessing = false;
                this.update();
                return;
            }

            // Validation 2: Check if gcc output contains "error" (case insensitive)
            if (!gccOutput.toLowerCase().includes('error')) {
                // Only warnings, show warning screen
                this.warningContext = { relativePath, code, gccOutput };
                this.showCompileWarnWarning = true;
                this.isProcessing = false;
                this.update();
                return;
            }

            // Validation 3: Check if .gcc.out is older than source file
            const fileStats = await this.fileService.resolve(fileUri);
            const gccStats = await this.fileService.resolve(gccOutUri);
            if (gccStats.mtime && fileStats.mtime && gccStats.mtime < fileStats.mtime) {
                // Source file was modified after gcc.out
                this.warningContext = { relativePath, code, gccOutput, fileUri, gccOutUri };
                this.showStaleGccWarning = true;
                this.isProcessing = false;
                this.update();
                return;
            }

            // All checks passed, proceed with compilation error analysis
            await this.submitCompileRequest('compile', relativePath, code, gccOutput);

        } catch (error) {
            console.error('AI Assistant: Error handling compile error', error);
            this.errorMessage = `Unexpected error: ${error}`;
            this.isProcessing = false;
            this.update();
        }
    }
}
