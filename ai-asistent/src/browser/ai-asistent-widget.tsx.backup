            }}>
                <div style={{ display: 'flex', alignItems: 'center', marginBottom: '15px' }}>
                    <i className="fa fa-exclamation-triangle" style={{
                        fontSize: '32px',
                        color: '#FFC107',
                        marginRight: '15px'
                    }}></i>
                    <h3 style={{
                        margin: 0,
                        color: '#FFC107',
                        fontSize: '18px'
                    }}>
                        {this.t('crashWarningTitle')}
                    </h3>
                </div>

                <p style={{
                    fontSize: '14px',
                    lineHeight: '1.6',
                    marginBottom: '0',
                    whiteSpace: 'pre-wrap'
                }}>
