                </p>
            </div>

            <div style={{ display: 'flex', gap: '10px', justifyContent: 'center' }}>
                <button
                    className="theia-button"
                    onClick={() => this.clearResponse()}
                    style={{ minWidth: '120px' }}
                >
                    {this.t('cancel')}
                </button>
                <button
                    className="theia-button secondary"
                    onClick={() => this.proceedWithCrashAnalysis()}
                    style={{ minWidth: '120px' }}
                >
                    {this.t('proceedAnyway')}
                </button>
            </div>
        </div>;
    }

    private async proceedWithCrashAnalysis() {
        try {
            this.isProcessing = true;
            this.showCrashWarning = false;
            this.errorMessage = '';
            this.aiResponse = '';
            this.update();

            // Call API with empty asan output (guessing mode)
            const formData = new FormData();
            formData.append('action', 'crash');
            formData.append('path', this.crashPath);
            formData.append('code', this.crashCode);
            formData.append('asan', ''); // Empty - AI will guess

            const response = await fetch('/api/v1/ai/asistent', {
                method: 'POST',
                credentials: 'include',
                body: formData
            });

            if (!response.ok) {
                await this.handleApiError(response);
                this.isProcessing = false;
                this.update();
                return;
            }

            const data = await response.json();

            if (data.data) {
                this.aiResponse = data.data;
            } else {
                this.errorMessage = this.t('apiError');
            }

        } catch (error) {
            console.error('AI Assistant: Error in proceedWithCrashAnalysis', error);
            this.errorMessage = `Unexpected error: ${error}`;
        } finally {
            this.isProcessing = false;
            this.crashCode = '';
            this.crashPath = '';
            this.update();
        }
    }

