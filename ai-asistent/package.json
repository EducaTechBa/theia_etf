{
  "name": "ai-asistent",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.0.0",
  "description": "AI teaching assistant",
  "author": "Vedran Ljubovic",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.66.2",
    "@theia/workspace": "1.66.2",
    "@theia/filesystem": "1.66.2"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "rimraf": "latest",
    "typescript": "latest"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run encode:images && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "encode:images": "node scripts/encode-images.js",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/ai-asistent-frontend-module"
    }
  ]
}
